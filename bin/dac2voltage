#!/usr/bin/env python3
#
# converts DAC value of CIRASAME common bias to the actual voltage
# or to do a reverse conversion. 
#
# created on 25.4.2024
#
import argparse

# Define global variables for slope and offset
slope = -0.114
offset = 70.567

def dac_to_voltage(dac_value):
    global slope, offset
    return dac_value * slope + offset

def voltage_to_dac(voltage_value):
    global slope, offset
    return int((voltage_value - offset) / slope)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Convert bias to voltage and vice versa.")
    parser.add_argument("value", type=float, help="Value to convert")
    parser.add_argument("-r", "--reverse", action="store_true", help="Reverse conversion")
    parser.add_argument("-d", "--dac", action="store_true", help="Convert from DAC to voltage (default)")
    parser.add_argument("-v", "--voltage", action="store_true", help="Convert from voltage to bias")
    args = parser.parse_args()

    if args.dac and args.voltage:
        parser.error("Cannot specify both --dac and --voltage")
    if args.reverse and args.dac:
        parser.error("Cannot specify both --dac and --reverse")
        
    if args.voltage and not args.reverse:
        args.reverse = True

    
    if not args.reverse:
        print(f"DAC value {args.value} corresponds to {dac_to_voltage(args.value):3f} V")
    if args.reverse:
        print(f"Voltage {args.value} corresponds to DAC value {voltage_to_dac(args.value):03d}")
